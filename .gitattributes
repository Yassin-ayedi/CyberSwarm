# Keep LF on files that run inside Linux containers — CRLF breaks shell shebangs,
# Dockerfiles and configs there. Normalise text, force LF where it matters.
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.rules     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.sql       text eol=lf
*.py        text eol=lf

# Treat video containers as binary (the parent folder has .mov files)
*.mov       binary
*.pcap      binary
