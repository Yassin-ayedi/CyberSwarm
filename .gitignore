# per-run outputs: the old pipeline's runs stay local, but the arena experiments are shared
# so a teammate can open the dashboard without running the lab (runs/arena, about 5 MB)
runs/*
!runs/arena/
lab/logs/
report/figures/
*.pcap

# python
__pycache__/
*.pyc
.venv/
venv/

# editor
.vscode/
.idea/

# local junk
_stale_runs/
*.log

# trained LoRA adapters (263 MB each; GitHub rejects files over 100 MB, share them another way)
ml/adapters/
